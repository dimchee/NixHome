{
    "layer": "bottom",
    "position": "top",
    "height": 24,
    "modules-left": ["sway/workspaces", "sway/mode" ],
    "modules-center": ["sway/window", "taskbar"],
    "modules-right": [ "mpd", "custom/pulseaudio", "backlight", "network", "cpu", "memory", "battery", "tray", "clock", "custom/lang"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1:web": "",
            "2:code": "",
            "3:term": "",
            "4:work": "",
            "5:music": "",
            "6:docs": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
	"backlight": {
		"format": "{percent}%"
	},
    "clock": {
        "format-alt": "{:%Y-%m-%d} 🇷🇸"
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
    "battery": {
        "bat": "BAT1",
        "states": {
            // "good": 95,
            "warning": 20,
            "critical": 12
        },
        "format": "{capacity}% {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
        "format-disconnected": "  ⚠  "
    },
	"mpd": {
		"format": "{title} 🎶  ",
		"format-stopped": "⏹️  ", 
		"format-paused": "⏸️  "
	},
	"custom/pulseaudio": {
		"format": " {} ",
		"interval": 5,
		"exec": "/etc/nixos/dotfiles/waybar/pulse.sh",
		"tooltip": false
	},
	"custom/lang": {
		"format": " {} ",
		"interval": 5,
		"exec": "/etc/nixos/dotfiles/waybar/keyboard.sh",
		"tooltip": false,
		"signal": 1
	},
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 14,
		"icon-theme": "Numix-Circle",
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close"
	}
}
